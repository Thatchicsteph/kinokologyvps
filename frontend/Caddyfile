# ---------------------------------------------------------------------------
# App routing: /api/* (incl. WebSockets) -> backend, everything else -> SPA
# ---------------------------------------------------------------------------
(app) {
	handle /api/* {
		reverse_proxy backend:8001
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# ---------------------------------------------------------------------------
# Kinkology app. Domain comes from the DOMAIN env var (set it in .env).
# ---------------------------------------------------------------------------
{$DOMAIN:ChangeMe} {
	import app
}

# ---------------------------------------------------------------------------
# MediaMTX WebRTC stream front-door. This container's Caddy terminates TLS for
# the stream subdomain and proxies WHEP (SDP over POST) to MediaMTX's HTTP
# WebRTC port on the host. host.docker.internal resolves to the VPS host from
# inside the container (see extra_hosts in docker-compose.yml).
#
# Set STREAM_DOMAIN in .env (e.g. streamtg30.ddns.net). If it is left unset,
# this site block binds a harmless placeholder and does nothing.
# ---------------------------------------------------------------------------
{$STREAM_DOMAIN:stream.invalid} {
	reverse_proxy host.docker.internal:8889
}

# Local owner access on the host: http://localhost
http://localhost {
	import app
}
