# Copy this file to ".env" in the project root before starting the stack:
#   cp env.docker.example .env
#
# Then build & run everything:
#   docker compose up -d --build
#
# JWT_SECRET signs the owner login tokens. Keep it private.
# REQUIRED: generate your own and paste it here (the app refuses to start otherwise):
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Public domain Caddy requests an HTTPS certificate for (Let's Encrypt).
# This is your GLOBAL address for remote guests. Ports 80 & 443 must reach the Mac.
DOMAIN=ChangeMe

# CORS: leave UNSET for the standard single-origin setup (frontend + /api served by
# the same Caddy). Only set this to a comma-separated allowlist of origins if you serve
# the frontend from a different domain than the backend.
# CORS_ORIGINS=https://ChangeMe

# --- OBS live stream (WHIP) + direct WebRTC for remote viewers -------------
# Set these to force a DIRECT WebRTC path (host/srflx candidates) instead of
# routing all media through the Cloudflare TURN relay. Direct = far better
# quality (no relay bottleneck) but REQUIRES you to forward this UDP range on
# your router to this host. If you can't forward ports, leave these unset and
# comment out the "50000-50099:50000-50099/udp" ports line in docker-compose.yml.
STREAM_UDP_MIN=50000
STREAM_UDP_MAX=50099
#
# The IP the backend advertises to remote peers in ICE candidates. This is
# written into the SDP, which requires a NUMERIC IP address — a hostname is
# auto-resolved to its IP at startup, but prefer the literal IP to be safe.
#   - Remote viewers over the internet: your home network's PUBLIC IP
#     (what your DDNS name resolves to — run `dig +short tg30.ddns.net`).
#   - OBS/viewers on the same LAN: the host's LAN IP, e.g. 192.168.1.42
#   - OBS on the same Mac as Docker only: 127.0.0.1
# NOTE: this only helps remote viewers if your router forwards the UDP range
# above to this host. If port-forwarding doesn't work (see COTURN.md), leave
# this UNSET and rely on the TURN relay instead.
# STREAM_PUBLIC_IP=203.0.113.42
#
# The address the backend uses to send ICE checks BACK to a publisher running
# on the host (OBS on the same machine). On Docker Desktop keep this as
# host.docker.internal so packets escape the bridge network. Leave unset if
# you only publish from the browser.
STREAM_PEER_IP=host.docker.internal

# --- WebRTC ICE servers (mobile / cross-network viewers) -------------------
# STUN lets the backend discover its public IP so mobile clients on 4G/5G or
# foreign networks can complete ICE. The default (Google + Cloudflare public
# STUN) is fine for almost everyone — only override if you need private STUN.
# STREAM_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
#
# TURN is a relay used when direct WebRTC fails, e.g. mobile carriers on
# symmetric NAT / CGNAT. Without it, phones on 4G/5G may see a black screen.
# Set up a self-hosted coturn relay (see COTURN.md) and point these at it:
# STREAM_TURN_URL=turn:your-vps-ip:3478
# STREAM_TURN_USERNAME=kinkology
# STREAM_TURN_PASSWORD=your-password
